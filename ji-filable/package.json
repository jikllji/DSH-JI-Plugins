{
  "name": "ji-filable",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "JI-Filable — drag-and-drop any non-image file into chat; session-scoped lossless file storage readable by the agent.",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["slots", "sessions", "locale"]
    }
  }
}
