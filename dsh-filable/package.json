{
  "name": "dsh-filable",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "description": "DSH-Filable — drag any file into chat; per-category routing between native DSH attachments and session-scoped lossless storage under the workspace sessionfiles/ dir, with polished file cards.",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "sessions",
        "locale"
      ]
    }
  },
  "files": [
    "dsh/",
    "lib/",
    "scripts/",
    "cordis.patch.yml",
    "CONTEXT.md",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs"
  }
}
